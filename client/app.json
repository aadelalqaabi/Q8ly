{
  "expo": {
    "name": "KUWAI",
    "slug": "kuwait-now",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/Splash.png",
      "resizeMode": "fit",
      "backgroundColor": "#0033A0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kuwaitnow",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "KUWAI needs camera access to take photos for posts.",
        "NSPhotoLibraryUsageDescription": "KUWAI needs photo library access to share photos and videos in posts.",
        "NSPhotoLibraryAddUsageDescription": "KUWAI needs access to save photos and videos.",
        "NSMicrophoneUsageDescription": "KUWAI needs microphone access for video recording."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0033A0"
      },
      "package": "app.kuwaitnow",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/75fe5b25-a004-4cec-a932-f72d6d68379c",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#0033A0",
          "sounds": []
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow KUWAI to access your photos and videos.",
          "savePhotosPermission": "Allow KUWAI to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "API_URL": "https://kuwaa-production.up.railway.app/api",
      "SOCKET_URL": "https://kuwaa-production.up.railway.app",
      "eas": {
        "projectId": "75fe5b25-a004-4cec-a932-f72d6d68379c"
      }
    },
    "owner": "qadha"
  }
}

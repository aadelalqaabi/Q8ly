NODE_ENV=production
PORT=5001

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/<dbname>

# JWT — generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=365d
# Admin JWT — use a DIFFERENT secret from JWT_SECRET: openssl rand -hex 64
JWT_ADMIN_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET

# OTP — set to false in production (requires Twilio credentials below)
OTP_TEST_MODE=false

# Twilio Verify
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SID=your_twilio_verify_sid

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Kuwaa <noreply@yourdomain.app>

# Frontend URL (update after deployment)
FRONTEND_URL=https://your-app.railway.app
CLIENT_URL=https://your-app.railway.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
